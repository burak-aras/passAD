FROM python:3.10-slim

# Proxy ayarları (build sırasında)
# ARG http_proxy
# ARG https_proxy
ENV http_proxy=$http_proxy
ENV https_proxy=$https_proxy

WORKDIR /app

# Install system dependencies and cron
RUN apt-get update && apt-get install -y \
    gcc \
    libldap2-dev \
    libsasl2-dev \
    cron \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY services/ ./services/
COPY jobs/ ./jobs/
COPY templates/emails/ ./templates/emails/
COPY entrypoint.job.sh .

# Setup Cron
COPY jobs/crontab /etc/cron.d/password-expiry-job
RUN chmod 0644 /etc/cron.d/password-expiry-job && \
    crontab /etc/cron.d/password-expiry-job && \
    chmod +x entrypoint.job.sh

# Create data directory
RUN mkdir -p /app/data

# Clear proxy for runtime
ENV http_proxy=
ENV https_proxy=

ENTRYPOINT ["./entrypoint.job.sh"]
