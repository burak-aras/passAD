# === Active Directory Settings ===
AD_SERVER=
AD_DOMAIN=
AD_BASE_DN=
AD_USER=
AD_PASSWORD=

# === SMTP Settings ===
SMTP_SERVER=
SMTP_PORT=25
SENDER_EMAIL=

# === Application Settings ===
# URL where this application is hosted (for email links)
PASSCORE_URL=http://localhost:5000
# Secret key for Flask sessions (change this in production)
SECRET_KEY=change_this_secret_key
# Admin panel password
ADMIN_PASSWORD=admin

# === Job Settings ===
# Days before expiry to start sending emails
WARNING_START=0
# Days before expiry to stop sending emails
WARNING_END=60
# Token validity in hours
TOKEN_VALIDITY_HOURS=24

# === Test Mode ===
# If set, all emails go tto this address instead of real users
TEST_RECIPIENT=
